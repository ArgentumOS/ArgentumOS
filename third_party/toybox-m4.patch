+// M6b: the boot mount set lives in the system.mounts domain. Display
+// prints the domain's entries, -a mounts them, and an explicit mount
+// persists a record through libconfig (so the next boot replays it).
+static int mount_display_cb(struct acct_mount *m, void *arg)
+{
+  if (m->fstype[0] && m->target[0])
+    xprintf("%s on %s type %s\n", m->source, m->target, m->fstype);
+  return 0;
+}
+
+static int mount_table_cb(struct acct_mount *m, void *arg)
+{
+  if (!m->fstype[0] || !m->target[0]) return 0;
+  if (mount(m->source, m->target, m->fstype, MS_SILENT, 0) && errno != EBUSY)
+    perror_msg("'%s'->'%s'", m->source, m->target);
+  return 0;
+}
+
+// record name for a tool-written mounts record: the target's last path
+// component, sanitized to a single-segment conf key ([A-Za-z0-9._-]).
+static char *mount_rec_name(const char *dir)
+{
+  char *base = strrchr(dir, '/');
+  char *p;
+
+  if (!base) base = (char *)dir;
+  else base++;
+  if (!*base) base = (char *)"mount";
+  snprintf(toybuf, sizeof(toybuf), "%.60s", base);
+  for (p = toybuf; *p; p++)
+    if (!isalnum(*p) && *p != '.' && *p != '_' && *p != '-') *p = '_';
+  return toybuf;
+}
+
