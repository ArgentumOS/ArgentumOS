diff --git a/lib/configedit.c b/lib/configedit.c
new file mode 100644
index 00000000..0194ba7e
--- /dev/null
+++ b/lib/configedit.c
@@ -0,0 +1,194 @@
+/* configedit.c - shared account-record editor over the FNX .conf identity
+ * domains (docs/system-config-files-plan.md M4).
+ *
+ * The account tools (passwd, useradd, userdel, groupadd, groupdel, chsh)
+ * read identity through libc getpwnam/getpwuid and getgrnam/getgrgid
+ * (musl serves them from the domains since M3) and write through this helper: every change is a
+ * libconfig atomic write into the System-scope domains
+ * (system.passwd.conf: records of container "user";
+ * system.group.conf: records of container "group").
+ *
+ * There is no /etc/shadow and no legacy account file: the password hash
+ * lives in the passwd record's "password" key; group memberships live in
+ * the group record's "members" comma list.
+ */
+
+#include "toys.h"
+#include <libconfig.h>
+
+#define ACCT_PW_DOM	"system.passwd"
+#define ACCT_GR_DOM	"system.group"
+#define ACCT_SH_DOM	"system.shells"
+
+/* set a record field to a string (or int via acct_set_ll) */
+int acct_set_str(const char *dom, const char *container, const char *rec,
+		 const char *field, const char *val)
+{
+	char key[320];
+
+	if (!val) val = "";
+	if (snprintf(key, sizeof key, "%s.%s.%s", container, rec, field)
+	    >= (int)sizeof key) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	if (config_set_string(CONFIG_SCOPE_SYSTEM, dom, key, val))
+		return -1;
+	return 0;
+}
+
+int acct_set_ll(const char *dom, const char *container, const char *rec,
+		const char *field, long long val)
+{
+	char key[320];
+
+	if (snprintf(key, sizeof key, "%s.%s.%s", container, rec, field)
+	    >= (int)sizeof key) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	if (config_set_int(CONFIG_SCOPE_SYSTEM, dom, key, val))
+		return -1;
+	return 0;
+}
+
+/* remove a whole record (every key under container.rec). Leaves other
+ * records and the container structure alone (empty containers drop out
+ * of the canonical file automatically). */
+int acct_del_record(const char *dom, const char *container, const char *rec)
+{
+	char prefix[300];
+	char **keys = NULL;
+	config_value_t *vals = NULL;
+	size_t n, i;
+	config_err_t e;
+	int rc = 0;
+
+	if (snprintf(prefix, sizeof prefix, "%s.%s", container, rec)
+	    >= (int)sizeof prefix) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	e = config_get_all(dom, prefix, &keys, &vals, &n);
+	if (e == CONFIG_ERR_NOT_FOUND) return 0;	/* nothing to do */
+	if (e) {
+		errno = EIO;
+		return -1;
+	}
+	for (i = 0; i < n; i++) {
+		e = config_unset(CONFIG_SCOPE_SYSTEM, dom, keys[i]);
+		if (e && e != CONFIG_ERR_NOT_FOUND) {
+			errno = EIO;
+			rc = -1;
+			break;
+		}
+	}
+	config_free_keys(keys, vals, n);
+	return rc;
+}
+
+/* write a group's member list from a NULL-terminated array of names */
+int acct_group_members_set(const char *group, char **members)
+{
+	size_t n = 0, len = 0, i;
+	char *csv, *p;
+
+	while (members && members[n]) len += strlen(members[n++]) + 1;
+	if (!n) {
+		if (acct_set_str(ACCT_GR_DOM, "group", group, "members", ""))
+			return -1;
+		return 0;
+	}
+	csv = p = xmalloc(len);
+	for (i = 0; i < n; i++) {
+		if (i) *p++ = ',';
+		p = stpcpy(p, members[i]);
+	}
+	i = acct_set_str(ACCT_GR_DOM, "group", group, "members", csv);
+	free(csv);
+	return i;
+}
+
+/* drop one member from a group's member list */
+int acct_group_member_del(const char *group, const char *user)
+{
+	struct group *gr = getgrnam(group);
+	char **keep = NULL;
+	size_t n = 0, cap = 0, i;
+	int rc = 0;
+
+	if (gr && gr->gr_mem) for (i = 0; gr->gr_mem[i]; i++) {
+		if (!strcmp(gr->gr_mem[i], user)) continue;
+		if (n == cap) {
+			cap = cap ? cap * 2 : 4;
+			keep = xrealloc(keep, cap * sizeof(char *));
+		}
+		keep[n++] = gr->gr_mem[i];
+	}
+	if (n) keep[n] = NULL;
+	if (acct_group_members_set(group, n ? keep : NULL)) rc = -1;
+	if (CFG_TOYBOX_FREE) free(keep);
+	return rc;
+}
+
+/* user + group record writers used by passwd/chsh/useradd */
+int acct_user_password_set(const char *user, const char *hash)
+{
+	return acct_set_str(ACCT_PW_DOM, "user", user, "password", hash);
+}
+
+int acct_user_shell_set(const char *user, const char *shell)
+{
+	return acct_set_str(ACCT_PW_DOM, "user", user, "shell", shell);
+}
+
+int acct_user_add(const char *user, uid_t uid, gid_t gid, const char *gecos,
+		  const char *home, const char *shell, const char *pass)
+{
+	if (acct_set_ll(ACCT_PW_DOM, "user", user, "uid", uid) ||
+	    acct_set_ll(ACCT_PW_DOM, "user", user, "gid", gid) ||
+	    acct_set_str(ACCT_PW_DOM, "user", user, "gecos",
+			 gecos ? gecos : "FNX User") ||
+	    acct_set_str(ACCT_PW_DOM, "user", user, "home", home) ||
+	    acct_set_str(ACCT_PW_DOM, "user", user, "shell", shell) ||
+	    acct_set_str(ACCT_PW_DOM, "user", user, "password",
+			 pass ? pass : "!"))
+		return -1;
+	return 0;
+}
+
+int acct_user_del(const char *user)
+{
+	return acct_del_record(ACCT_PW_DOM, "user", user);
+}
+
+int acct_group_add(const char *group, gid_t gid)
+{
+	if (acct_set_ll(ACCT_GR_DOM, "group", group, "gid", gid) ||
+	    acct_set_str(ACCT_GR_DOM, "group", group, "members", ""))
+		return -1;
+	return 0;
+}
+
+int acct_group_del(const char *group)
+{
+	return acct_del_record(ACCT_GR_DOM, "group", group);
+}
+
+/* is `shell` listed in the shells domain (system.shells, key
+ * "shells")? The value may be a single string or a comma array. */
+int acct_shell_allowed(const char *shell)
+{
+	const char *str;
+	config_value_t *items = 0;
+	size_t n = 0, i;
+	config_err_t e = config_get_string(ACCT_SH_DOM, "shells", &str);
+
+	if (!e && !strcmp(str, shell)) return 1;
+	e = config_get_array(ACCT_SH_DOM, "shells", &items, &n);
+	if (e) return 0;
+	for (i = 0; i < n; i++)
+		if (items[i].type == CONFIG_TYPE_STRING &&
+		    !strcmp(items[i].v.string, shell)) return 1;
+	return 0;
+}
