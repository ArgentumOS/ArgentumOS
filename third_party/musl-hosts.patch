+/* collect records stored at the domain root (no wrapper container):
+ * pwconf emits only assignment entries, keyed with dotted paths, so a
+ * flat file's record is the first key segment (localhost.addresses ->
+ * record 'localhost', field 'addresses'). Used by record-kind domains
+ * whose name already says what the records are (system.hosts,
+ * system.mounts), where a wrapper container would only duplicate the
+ * noun. Records keep source order (first appearance). */
+static int pwdb_build_flat(struct pwdb *db, struct pwentry *head)
+{
+	struct pwentry *e;
+
+	db->recs = NULL;
+	db->nrecs = 0;
+	for(e = head; e; e = e->next) {
+		const char *dot = strchr(e->key, '.');
+		size_t nl = dot ? (size_t)(dot - e->key) : strlen(e->key);
+		struct pwrec *r = NULL;
+		struct pwrec *cur;
+
+		if(!nl) {
+			continue;	/* no record name (empty key) */
+		}
+		for(cur = db->recs; cur; cur = cur->next) {
+			if(strlen(cur->name) == nl &&
+			   !strncmp(cur->name, e->key, nl)) {
+				r = cur;
+				break;
+			}
+		}
+		if(!r) {
+			struct pwrec *nr = calloc(1, sizeof(*nr));
+
+			if(!nr) {
+				return ENOMEM;
+			}
+			nr->name = strndup(e->key, nl);
+			if(!nr->name) {
+				free(nr);
+				return ENOMEM;
+			}
+			if(db->recs) {
+				struct pwrec *t = db->recs;
+
+				while(t->next) {
+					t = t->next;
+				}
+				t->next = nr;
+			} else {
+				db->recs = nr;
+			}
+			db->nrecs++;
+			r = nr;
+		}
+		if(!dot) {
+			continue;	/* root scalar, not a field */
+		}
+		/* add/replace the field entry */
+		{
+			const char *field = dot + 1;
+			struct pwentry *fe;
+			struct pwentry *prev;
+
+			prev = NULL;
+			for(fe = r->fields; fe; prev = fe, fe = fe->next) {
+				if(!strcmp(fe->key, field)) {
+					break;
+				}
+			}
+			if(fe) {
+				char *nv = strdup(e->val);
+
+				if(!nv) {
+					return ENOMEM;
+				}
+				free(fe->val);
+				fe->val = nv;
+			} else {
+				fe = calloc(1, sizeof(*fe));
+				if(!fe) {
+					return ENOMEM;
+				}
+				fe->key = strdup(field);
+				if(!fe->key) {
+					free(fe);
+					return ENOMEM;
+				}
+				fe->val = strdup(e->val);
+				if(!fe->val) {
+					free(fe->key);
+					free(fe);
+					return ENOMEM;
+				}
+				if(prev) {
+					prev->next = fe;
+				} else {
+					r->fields = fe;
+				}
+				r->nfields++;
+			}
+		}
+	}
+	return 0;
+}
