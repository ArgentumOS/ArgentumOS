+/* Render the hosts domain (system.hosts.conf) as classic hosts
+ * lines ("address name [alias ...]") so musl's name_from_hosts
+ * (lookup_name.c) keeps its line parser unchanged. The domain is
+ * dedicated to host records, so each top-level record is one host
+ * (no `hosts` container wrapper - system.hosts.localhost, not
+ * system.hosts.hosts.localhost): `addresses` is the comma list of
+ * IPs, `aliases` the extra names. Records render in source order,
+ * one line per address. Same FILE contract as __pwconf_passwd_fopen
+ * (a self-contained fmemopen stream). Returns NULL with errno set
+ * when the domain cannot be read (ENOENT = no hosts = no file). */
+FILE *__pwconf_hosts_fopen(void)
+{
+	struct pwdb db = { NULL, 0 };
+	struct pwentry *entries = NULL;
+	FILE *f = NULL;
+	char *buf = NULL;
+	size_t len = 0;
+	FILE *in;
+	char *text = NULL;
+	long n;
+	struct pwrec *r;
+
+	in = fopen(PWCONF_HOSTS_PATH, "rbe");
+	if(!in) {
+		return NULL;	/* errno from fopen (ENOENT etc.) */
+	}
+	if(fseek(in, 0, SEEK_END) || (n = ftell(in)) < 0 ||
+	   (unsigned long)n > PWCONF_MAX_FILE) {
+		errno = EFBIG;
+		goto out;
+	}
+	rewind(in);
+	text = malloc((size_t)n + 1);
+	if(!text) {
+		errno = ENOMEM;
+		goto out;
+	}
+	if(fread(text, 1, (size_t)n, in) != (size_t)n) {
+		errno = EIO;
+		goto out;
+	}
+	text[n] = '\0';
+	if(pwconf_parse(text, (size_t)n, &entries) ||
+	   pwdb_build_flat(&db, entries)) {
+		errno = EIO;
+		goto out;
+	}
+	f = open_memstream(&buf, &len);
+	if(!f) {
+		errno = ENOMEM;
+		goto out;
+	}
+	for(r = db.recs; r; r = r->next) {
+		char **addrs = NULL, **aliases = NULL;
+		int na, nali, i;
+
+		na = pwconf_members(pwrec_field(r, "addresses"), &addrs);
+		nali = pwconf_members(pwrec_field(r, "aliases"), &aliases);
+		if(na < 0 || nali < 0) {
+			errno = ENOMEM;
+			if(na >= 0 && addrs) {
+				for(i = 0; i < na; i++) {
+					free(addrs[i]);
+				}
+			}
+			if(nali >= 0 && aliases) {
+				for(i = 0; i < nali; i++) {
+					free(aliases[i]);
+				}
+			}
+			free(addrs);
+			free(aliases);
+			fclose(f);
+			f = NULL;
+			goto out;
+		}
+		for(i = 0; i < na; i++) {
+			int j;
+
+			fprintf(f, "%s %s", addrs[i], r->name);
+			for(j = 0; j < nali; j++) {
+				fprintf(f, " %s", aliases[j]);
+			}
+			fputc('\n', f);
+		}
+		for(i = 0; i < na; i++) {
+			free(addrs[i]);
+		}
+		for(i = 0; i < nali; i++) {
+			free(aliases[i]);
+		}
+		free(addrs);
+		free(aliases);
+	}
+	if(fflush(f) || ferror(f)) {
+		fclose(f);
+		f = NULL;
+		errno = EIO;
+		goto out;
+	}
+	{
+		FILE *rf = fmemopen(NULL, len, "w+");
+
+		if(!rf) {
+			errno = ENOMEM;
+			fclose(f);
+			f = NULL;
+			goto out;
+		}
+		if(fwrite(buf, 1, len, rf) != len ||
+		   fflush(rf) || ferror(rf)) {
+			fclose(rf);
+			fclose(f);
+			f = NULL;
+			errno = EIO;
+			goto out;
+		}
+		rewind(rf);
+		fclose(f);	/* frees the memstream buffer */
+		f = rf;
+	}
+out:
+	free(text);
+	pwconf_entries_free(entries);
+	pwdb_free(&db);
+	if(in) {
+		fclose(in);
+	}
 	return f;
 }
