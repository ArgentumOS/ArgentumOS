diff --git a/src/passwd/pwconf.c b/src/passwd/pwconf.c
new file mode 100644
--- /dev/null
+++ b/src/passwd/pwconf.c
@@ -0,0 +1,1162 @@
+/* pwconf.c — libc-internal reader for the FNX identity .conf domains.
+ *
+ * getpwnam/getpwuid and getgrnam/getgrgid read the record domains in
+ * /System/Configuration (system.passwd.conf,
+ * system.group.conf) instead of legacy colon files. Each record is rendered as a classic
+ * "name:passwd:uid:gid:gecos:home:shell" (passwd) or
+ * "name::gid:member1,member2" (group) line over an open_memstream
+ * FILE, so musl's existing line parsers work unchanged. Records are
+ * rendered sorted by uid (passwd) or gid (group).
+ *
+ * This is deliberately NOT userland/libconfig.c: libc cannot depend on
+ * userland code, and libconfig's scope machinery itself calls
+ * getpwuid. Grammar subset implemented here (read-only):
+ * docs/config-design.md §10 + §10.1 — flat and block values (group
+ * records), full-line comments, quoted strings with \escapes, integers,
+ * comma arrays. Input is bounded and failures leave errno set.
+ *
+ * THE PLIST SPELLING IS READ WITH THE SHARED CORE (P3d, P3c:
+ * docs/design/plist-config-plan.md): `include/plist.h` + `userland/plist.c` are
+ * copied into this directory by the toolchain rule and compiled into libc, so
+ * there is ONE XML implementation in the system rather than a second one here.
+ * The core's tree is flattened into the SAME (full dotted key -> RAW value)
+ * list the legacy parser produces, which is why every consumer below is
+ * untouched by the choice of spelling.
+ */
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "plist.h"
+#include "pwf.h"
+#include "pwconf.h"
+
+#define PWCONF_MAX_FILE		(1024 * 1024)
+#define PWCONF_MAX_LINE		4096
+#define PWCONF_PASSWD_PATH	"/System/Configuration/system.passwd.conf"
+#define PWCONF_GROUP_PATH	"/System/Configuration/system.group.conf"
+
+/* one parsed key = raw right-hand-side text (verbatim: quotes and
+ * commas are kept; interpretation happens at render time) */
+struct pwentry {
+	char *key;
+	char *val;
+	struct pwentry *next;
+};
+
+/* ---- parser ------------------------------------------------------ */
+
+static void pwconf_entries_free(struct pwentry *e)
+{
+	while(e) {
+		struct pwentry *n = e->next;
+
+		free(e->key);
+		free(e->val);
+		free(e);
+		e = n;
+	}
+}
+
+/* ---- the plist spelling (P3d) -------------------------------------
+ *
+ * See the header note: the core does the XML, this arm flattens its tree into
+ * the raw key/value list above. Detection is by CONTENT (the first non-blank
+ * character is '<'), the same rule libconfig uses, so a domain's spelling is
+ * never guessed from its name.
+ */
+
+/* A growable raw-text buffer; the renderers below build into one. */
+static int pwconf_append(char **buf, size_t *len, size_t *cap, const char *text,
+			 size_t n)
+{
+	char *fresh;
+
+	if(*len + n + 1 > *cap) {
+		size_t grown = *cap ? *cap : 64;
+
+		while(*len + n + 1 > grown) {
+			grown *= 2;
+		}
+		fresh = realloc(*buf, grown);
+		if(!fresh) {
+			return ENOMEM;
+		}
+		*buf = fresh;
+		*cap = grown;
+	}
+	memcpy(*buf + *len, text, n);
+	*len += n;
+	(*buf)[*len] = '\0';
+	return 0;
+}
+
+/* Does this text need quoting to survive the raw-value grammar? Empty text
+ * does (an empty raw value reads as absent), as does anything carrying
+ * whitespace, a comma, a '#' or a quote: unquoted, those read as something
+ * else — or, for a comma, as two members. */
+static int pwconf_needs_quotes(const char *s)
+{
+	if(!*s) {
+		return 1;
+	}
+	for(; *s; s++) {
+		if(*s == ' ' || *s == '\t' || *s == ',' || *s == '#' ||
+		   *s == '"' || *s == '\'' || *s == '\\') {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static int pwconf_raw_string(char **buf, size_t *len, size_t *cap,
+			     const char *s)
+{
+	int rc;
+
+	if(!pwconf_needs_quotes(s)) {
+		return pwconf_append(buf, len, cap, s, strlen(s));
+	}
+	rc = pwconf_append(buf, len, cap, "\"", 1);
+	for(; *s && !rc; s++) {
+		switch(*s) {
+		case '"':
+			rc = pwconf_append(buf, len, cap, "\\\"", 2);
+			break;
+		case '\\':
+			rc = pwconf_append(buf, len, cap, "\\\\", 2);
+			break;
+		case '\n':
+			rc = pwconf_append(buf, len, cap, "\\n", 2);
+			break;
+		case '\t':
+			rc = pwconf_append(buf, len, cap, "\\t", 2);
+			break;
+		default:
+			rc = pwconf_append(buf, len, cap, s, 1);
+			break;
+		}
+	}
+	if(!rc) {
+		rc = pwconf_append(buf, len, cap, "\"", 1);
+	}
+	return rc;
+}
+
+/* One plist value as the RAW text the renderers expect: an integer as bare
+ * digits, a real as %g, a boolean as true/false, a string quoted only when it
+ * must be, and an ARRAY as the comma list pwconf_members splits. A <date> or
+ * <data> is EINVAL: the identity model has no such field, and inventing one is
+ * how a reader starts losing an account. */
+static int pwconf_plist_raw(const plist_value_t *v, int depth, char **out)
+{
+	char *buf = NULL;
+	size_t len = 0, cap = 0;
+	int rc = 0;
+
+	*out = NULL;
+	if(depth > 32) {
+		return EINVAL;
+	}
+	switch(plist_type_of(v)) {
+	case PLIST_STRING:
+		rc = pwconf_raw_string(&buf, &len, &cap,
+				       v->u.string ? v->u.string : "");
+		break;
+	case PLIST_INTEGER:
+		{
+			char n[32];
+
+			snprintf(n, sizeof n, "%lld", v->u.integer);
+			rc = pwconf_append(&buf, &len, &cap, n, strlen(n));
+		}
+		break;
+	case PLIST_REAL:
+		{
+			char n[64];
+
+			snprintf(n, sizeof n, "%g", v->u.real);
+			rc = pwconf_append(&buf, &len, &cap, n, strlen(n));
+		}
+		break;
+	case PLIST_BOOLEAN:
+		rc = pwconf_append(&buf, &len, &cap,
+				   v->u.boolean ? "true" : "false",
+				   v->u.boolean ? 4 : 5);
+		break;
+	case PLIST_ARRAY:
+		{
+			size_t i;
+
+			for(i = 0; i < v->u.array.count && !rc; i++) {
+				char *item = NULL;
+
+				if(i) {
+					rc = pwconf_append(&buf, &len, &cap,
+							   ", ", 2);
+				}
+				if(!rc) {
+					rc = pwconf_plist_raw(v->u.array.items[i],
+							      depth + 1, &item);
+				}
+				if(!rc) {
+					rc = pwconf_append(&buf, &len, &cap, item,
+							   strlen(item));
+				}
+				free(item);
+			}
+		}
+		break;
+	default:
+		rc = EINVAL;
+		break;
+	}
+	if(rc) {
+		free(buf);
+		return rc;
+	}
+	if(!buf) {
+		buf = malloc(1);
+		if(!buf) {
+			return ENOMEM;
+		}
+		buf[0] = '\0';
+	}
+	*out = buf;
+	return 0;
+}
+
+/* the list being built, so a nested walk needs no tail pointer */
+struct pwbuild {
+	struct pwentry *head;
+	struct pwentry *tail;
+};
+
+/* Put one (key, raw) pair: an exact duplicate is LAST-WINS but keeps its FIRST
+ * position, which is what the legacy parser does — a domain read twice must
+ * neither grow nor reshuffle. Takes ownership of both on success. */
+static int pwconf_put(struct pwbuild *b, char *key, char *val)
+{
+	struct pwentry *e;
+
+	for(e = b->head; e; e = e->next) {
+		if(!strcmp(e->key, key)) {
+			free(e->val);
+			e->val = val;
+			free(key);
+			return 0;
+		}
+	}
+	e = malloc(sizeof *e);
+	if(!e) {
+		return ENOMEM;
+	}
+	e->key = key;
+	e->val = val;
+	e->next = NULL;
+	if(b->tail) {
+		b->tail->next = e;
+	} else {
+		b->head = e;
+	}
+	b->tail = e;
+	return 0;
+}
+
+/* Walk a dictionary into full dotted keys: a nested dictionary is a dotted
+ * PREFIX (the plist spelling of a block) and everything else is a leaf. A NULL
+ * key is a COMMENT slot — prose, for which the identity model has no place. */
+static int pwconf_plist_walk(const plist_value_t *dict, const char *prefix,
+			     struct pwbuild *b, int depth)
+{
+	size_t i, pl = strlen(prefix);
+
+	if(depth > 32) {
+		return EINVAL;
+	}
+	for(i = 0; i < dict->u.dictionary.count; i++) {
+		const char *name = dict->u.dictionary.keys[i];
+		const plist_value_t *v = dict->u.dictionary.values[i];
+		char *key, *raw = NULL;
+		int rc;
+
+		if(!name) {
+			continue;
+		}
+		key = malloc(pl + (pl ? 1 : 0) + strlen(name) + 1);
+		if(!key) {
+			return ENOMEM;
+		}
+		if(pl) {
+			memcpy(key, prefix, pl);
+			key[pl] = '.';
+			strcpy(key + pl + 1, name);
+		} else {
+			strcpy(key, name);
+		}
+		if(plist_type_of(v) == PLIST_DICTIONARY) {
+			rc = pwconf_plist_walk(v, key, b, depth + 1);
+			free(key);
+			if(rc) {
+				return rc;
+			}
+			continue;
+		}
+		rc = pwconf_plist_raw(v, depth, &raw);
+		if(!rc) {
+			rc = pwconf_put(b, key, raw);
+		}
+		if(rc) {
+			free(key);
+			free(raw);
+			return rc;
+		}
+	}
+	return 0;
+}
+
+/* The plist route: the core parses, this flattens. */
+static int pwconf_parse_plist(const char *text, size_t len, struct pwentry **out)
+{
+	struct pwbuild b;
+	char message[64];
+	plist_value_t *root;
+	int rc;
+
+	*out = NULL;
+	b.head = b.tail = NULL;
+	root = plist_parse(text, len, message, sizeof message);
+	if(!root) {
+		return EINVAL;
+	}
+	if(plist_type_of(root) != PLIST_DICTIONARY) {
+		rc = EINVAL;
+	} else {
+		rc = pwconf_plist_walk(root, "", &b, 0);
+	}
+	plist_free(root);
+	if(rc) {
+		pwconf_entries_free(b.head);
+		return rc;
+	}
+	*out = b.head;
+	return 0;
+}
+
+/* parse whole-file text into an ordered list of full dotted keys with
+ * raw values; exact-key duplicates are last-wins keeping the first
+ * position. Returns 0 or an errno value (ENOMEM/EINVAL). */
+static int pwconf_parse(const char *text, size_t len, struct pwentry **out)
+{
+	struct pwentry *head = NULL, *tail = NULL;
+	char *stack[64];
+	int depth = 0;
+	size_t off = 0;
+	int rc = 0;
+
+	*out = NULL;
+	if(len >= 3 && (unsigned char)text[0] == 0xEF &&
+	   (unsigned char)text[1] == 0xBB && (unsigned char)text[2] == 0xBF) {
+		off = 3;	/* skip a UTF-8 BOM */
+	}
+	{
+		/* A plist domain is read by the core arm above and produces the
+		 * same entry list, so nothing below this line knows which
+		 * spelling the file used. */
+		size_t i = off;
+
+		while(i < len && (text[i] == ' ' || text[i] == '\t' ||
+				  text[i] == '\r' || text[i] == '\n')) {
+			i++;
+		}
+		if(i < len && text[i] == '<') {
+			return pwconf_parse_plist(text + off, len - off, out);
+		}
+	}
+	while(off < len) {
+		char line[PWCONF_MAX_LINE + 1];
+		char *p, *eq, *keyend, *val, *full;
+		size_t n = 0, pl = 0;
+
+		while(off < len && text[off] != '\n' && n < PWCONF_MAX_LINE) {
+			line[n++] = text[off++];
+		}
+		if(off < len && text[off] == '\n') {
+			off++;
+		} else if(n == PWCONF_MAX_LINE && off < len) {
+			rc = EINVAL;	/* line too long */
+			break;
+		}
+		line[n] = '\0';
+		while(n && (line[n-1] == '\r' || line[n-1] == ' ' ||
+			    line[n-1] == '\t')) {
+			line[--n] = '\0';
+		}
+		p = line;
+		while(*p == ' ' || *p == '\t') {
+			p++;
+		}
+		if(!*p || *p == '#') {
+			continue;	/* empty or full-line comment */
+		}
+		if(*p == '}') {
+			char *q = p + 1;
+
+			while(*q == ' ' || *q == '\t') {
+				q++;
+			}
+			if(*q || !depth) {
+				rc = EINVAL;
+				break;
+			}
+			depth--;
+			continue;
+		}
+		eq = strchr(p, '=');
+		if(!eq) {
+			rc = EINVAL;
+			break;
+		}
+		keyend = eq;
+		while(keyend > p && (keyend[-1] == ' ' || keyend[-1] == '\t')) {
+			keyend--;
+		}
+		*keyend = '\0';
+		val = eq + 1;
+		while(*val == ' ' || *val == '\t') {
+			val++;
+		}
+		if(depth) {
+			struct pwentry *cur;
+
+			for(cur = head; cur; cur = cur->next) {
+				size_t dl = strlen(cur->key);
+
+				if(dl && !strncmp(cur->key, stack[depth-1], dl)
+				   && stack[depth-1][dl] == '.') {
+					rc = EINVAL;	/* nested scalar used
+							 * as container */
+					break;
+				}
+			}
+			if(rc) {
+				break;
+			}
+		}
+		pl = depth ? strlen(stack[depth-1]) + 1 : 0;
+		full = malloc(pl + strlen(p) + 1);
+		if(!full) {
+			rc = ENOMEM;
+			break;
+		}
+		if(depth) {
+			memcpy(full, stack[depth-1], pl - 1);
+			full[pl-1] = '.';
+			strcpy(full + pl, p);
+		} else {
+			strcpy(full, p);
+		}
+		if(*val == '{') {
+			/* group open: single-segment key; relative key == the
+			 * whole dotted rest is not allowed for blocks here */
+			char *q = val + 1;
+			int empty = 0;
+
+			if(strchr(p, '.')) {
+				free(full);
+				rc = EINVAL;
+				break;
+			}
+			while(*q == ' ' || *q == '\t') {
+				q++;
+			}
+			if(*q == '}') {
+				empty = 1;
+				q++;
+				while(*q == ' ' || *q == '\t') {
+					q++;
+				}
+				if(*q) {
+					free(full);
+					rc = EINVAL;
+					break;
+				}
+			} else if(*q) {
+				free(full);
+				rc = EINVAL;
+				break;
+			}
+			if(!empty) {
+				if(depth == 64) {
+					free(full);
+					rc = EINVAL;
+					break;
+				}
+				stack[depth++] = full;	/* container prefix */
+			} else {
+				free(full);
+			}
+			continue;
+		}
+		/* plain assignment */
+		{
+			struct pwentry *cur, *en;
+
+			/* reject "name used as both scalar and container" */
+			for(cur = head; cur; cur = cur->next) {
+				size_t fl = strlen(full);
+				size_t el = strlen(cur->key);
+
+				if(!strcmp(cur->key, full)) {
+					free(cur->val);
+					cur->val = strdup(val);
+					if(!cur->val) {
+						rc = ENOMEM;
+					}
+					free(full);
+					break;
+				}
+				if(el > fl && !strncmp(cur->key, full, fl) &&
+				   cur->key[fl] == '.') {
+					rc = EINVAL;
+					break;
+				}
+				if(el < fl && !strncmp(full, cur->key, el) &&
+				   full[el] == '.') {
+					rc = EINVAL;
+					break;
+				}
+			}
+			if(rc) {
+				free(full);
+				break;
+			}
+			if(cur && !rc) {
+				continue;
+			}
+			en = malloc(sizeof(*en));
+			if(!en) {
+				free(full);
+				rc = ENOMEM;
+				break;
+			}
+			en->val = strdup(val);
+			if(!en->val) {
+				free(full);
+				free(en);
+				rc = ENOMEM;
+				break;
+			}
+			en->key = full;
+			en->next = NULL;
+			if(tail) {
+				tail->next = en;
+			} else {
+				head = en;
+			}
+			tail = en;
+		}
+	}
+	if(depth) {
+		rc = EINVAL;	/* unbalanced '{' */
+	}
+	if(rc) {
+		pwconf_entries_free(head);
+		return rc;
+	}
+	*out = head;
+	return 0;
+}
+
+/* ---- value helpers ------------------------------------------------ */
+
+/* unquote a raw value; returns malloc'd content or NULL (ENOMEM).
+ * Bare tokens are copied verbatim; quoted values get \escapes applied. */
+static char *pwconf_unquote(const char *raw)
+{
+	char *out = malloc(strlen(raw) + 1);
+	size_t i, n = 0;
+	int quoted = 0;
+
+	if(!out) {
+		return NULL;
+	}
+	if(*raw == '"') {
+		quoted = 1;
+		raw++;
+	}
+	for(i = 0; raw[i]; i++) {
+		if(raw[i] == '\\' && quoted) {
+			switch(raw[++i]) {
+			case 'n': out[n++] = '\n'; break;
+			case 't': out[n++] = '\t'; break;
+			case '"': out[n++] = '"'; break;
+			case '\\': out[n++] = '\\'; break;
+			default:
+				if(!raw[i]) {
+					goto done;
+				}
+				out[n++] = raw[i];
+				break;
+			}
+		} else if(raw[i] == '"' && quoted) {
+			break;	/* closing quote */
+		} else {
+			out[n++] = raw[i];
+		}
+	}
+done:
+	out[n] = '\0';
+	return out;
+}
+
+/* integer value (raw int or quoted digits); returns 0 when absent or
+ * unparseable (then *out = 0) */
+static void pwconf_raw_int(const char *raw, unsigned *out)
+{
+	char *s;
+
+	if(!raw) {
+		*out = 0;
+		return;
+	}
+	while(*raw == ' ' || *raw == '\t') {
+		raw++;
+	}
+	if(*raw == '"') {
+		raw++;
+	}
+	s = (char *)raw;
+	*out = (unsigned)strtoul(s, &s, 10);
+}
+
+/* split a raw value on top-level commas into malloc'd member tokens
+ * (unquoted, whitespace-trimmed). Returns count (>= 0) or -1 (ENOMEM).
+ * Empty/absent raw -> 0 members, *toks = NULL. */
+static int pwconf_members(const char *raw, char ***toks)
+{
+	char *copy, *p, *q;
+	int count = 0, cap = 0, i;
+	char **arr = NULL;
+	char **na;
+
+	if(!raw || !*raw || !strcmp(raw, "\"\"")) {
+		*toks = NULL;
+		return 0;
+	}
+	copy = pwconf_unquote(raw);
+	if(!copy) {
+		return -1;
+	}
+	p = copy;
+	while(*p) {
+		char *tok = NULL;
+		size_t tl;
+
+		while(*p == ' ' || *p == '\t' || *p == ',') {
+			p++;
+		}
+		if(!*p) {
+			break;
+		}
+		q = p;
+		while(*q && *q != ',') {
+			q++;
+		}
+		tl = q - p;
+		while(tl && (p[tl-1] == ' ' || p[tl-1] == '\t')) {
+			tl--;
+		}
+		tok = malloc(tl + 1);
+		if(!tok) {
+			free(copy);
+			for(i = 0; i < count; i++) {
+				free(arr[i]);
+			}
+			free(arr);
+			return -1;
+		}
+		memcpy(tok, p, tl);
+		tok[tl] = '\0';
+		if(count == cap) {
+			cap = cap ? cap * 2 : 4;
+			na = realloc(arr, cap * sizeof(char *));
+			if(!na) {
+				free(tok);
+				free(copy);
+				for(i = 0; i < count; i++) {
+					free(arr[i]);
+				}
+				free(arr);
+				return -1;
+			}
+			arr = na;
+		}
+		arr[count++] = tok;
+		p = q;
+	}
+	free(copy);
+	if(!count) {
+		free(arr);
+		arr = NULL;
+	}
+	*toks = arr;
+	return count;
+}
+
+/* ---- record extraction -------------------------------------------- */
+
+struct pwrec {
+	char *name;		/* record name (e.g. "admin") */
+	struct pwentry *fields;	/* container.name.* entries */
+	int nfields;
+	struct pwrec *next;
+};
+
+struct pwdb {
+	struct pwrec *recs;	/* records of the container, source order */
+	int nrecs;
+};
+
+static struct pwrec *pwdb_find(struct pwdb *db, const char *name)
+{
+	struct pwrec *r;
+
+	for(r = db->recs; r; r = r->next) {
+		if(!strcmp(r->name, name)) {
+			return r;
+		}
+	}
+	return NULL;
+}
+
+/* value of a field of a record, or NULL when absent */
+static const char *pwrec_field(const struct pwrec *r, const char *field)
+{
+	struct pwentry *e;
+	size_t fl = strlen(field);
+
+	for(e = r->fields; e; e = e->next) {
+		if(strlen(e->key) == fl && !strcmp(e->key, field)) {
+			return e->val;
+		}
+	}
+	return NULL;
+}
+
+/* collect records of the top-level container `container` (e.g. "user")
+ * from the parsed entries; the container's fields may be stored flat
+ * (container.rec.field) or nested. Returns 0 / errno. */
+static int pwdb_build(struct pwdb *db, struct pwentry *head,
+		      const char *container)
+{
+	size_t cl = strlen(container);
+	struct pwentry *e;
+
+	db->recs = NULL;
+	db->nrecs = 0;
+	for(e = head; e; e = e->next) {
+		const char *rest;
+		const char *dot;
+		const char *field;
+		size_t rl, frest;
+		struct pwrec *r;
+		struct pwentry *fe;
+
+		if(strncmp(e->key, container, cl) || e->key[cl] != '.') {
+			continue;
+		}
+		rest = e->key + cl + 1;
+		dot = strchr(rest, '.');
+		if(!dot) {
+			continue;	/* a bare container leaf */
+		}
+		rl = dot - rest;
+		field = dot + 1;
+		r = pwdb_find(db, rest);	/* rest[:rl] NUL-free compare */
+		if(!r || strcmp(r->name, rest)) {
+			/* pwdb_find compared the full rest; record names
+			 * are exactly rl chars: match by prefix */
+			struct pwrec *nr;
+			struct pwrec *cur;
+
+			for(cur = db->recs; cur; cur = cur->next) {
+				if(strlen(cur->name) == rl &&
+				   !strncmp(cur->name, rest, rl)) {
+					r = cur;
+					break;
+				}
+			}
+			if(!r) {
+				nr = calloc(1, sizeof(*nr));
+				if(!nr) {
+					return ENOMEM;
+				}
+				nr->name = strndup(rest, rl);
+				if(!nr->name) {
+					free(nr);
+					return ENOMEM;
+				}
+				nr->next = NULL;
+				if(db->recs) {
+					struct pwrec *t = db->recs;
+
+					while(t->next) {
+						t = t->next;
+					}
+					t->next = nr;
+				} else {
+					db->recs = nr;
+				}
+				db->nrecs++;
+				r = nr;
+			}
+		}
+		/* add/replace the field entry */
+		frest = strlen(field);
+		for(fe = r->fields; fe; fe = fe->next) {
+			if(!strcmp(fe->key, field)) {
+				break;
+			}
+		}
+		if(fe) {
+			char *nv = strdup(e->val);
+
+			if(!nv) {
+				return ENOMEM;
+			}
+			free(fe->val);
+			fe->val = nv;
+		} else {
+			fe = calloc(1, sizeof(*fe));
+			if(!fe) {
+				return ENOMEM;
+			}
+			fe->key = strdup(field);
+			if(!fe->key) {
+				free(fe);
+				return ENOMEM;
+			}
+			fe->val = strdup(e->val);
+			if(!fe->val) {
+				free(fe->key);
+				free(fe);
+				return ENOMEM;
+			}
+			if(r->fields) {
+				struct pwentry *t = r->fields;
+
+				while(t->next) {
+					t = t->next;
+				}
+				t->next = fe;
+			} else {
+				r->fields = fe;
+			}
+			r->nfields++;
+		}
+	}
+	return 0;
+}
+
+static void pwdb_free(struct pwdb *db)
+{
+	struct pwrec *r = db->recs;
+
+	while(r) {
+		struct pwrec *n = r->next;
+
+		pwconf_entries_free(r->fields);
+		free(r->name);
+		free(r);
+		r = n;
+	}
+	db->recs = NULL;
+	db->nrecs = 0;
+}
+
+/* ---- rendering ---------------------------------------------------- */
+
+struct recidx {
+	struct pwrec *rec;
+	unsigned key;	/* uid or gid for sorting */
+};
+
+static int recidx_cmp(const void *a, const void *b)
+{
+	const struct recidx *ra = a, *rb = b;
+
+	if(ra->key != rb->key) {
+		return ra->key < rb->key ? -1 : 1;
+	}
+	return strcmp(ra->rec->name, rb->rec->name);
+}
+
+/* Render the passwd domain. All records of the `user` container, sorted
+ * by uid. Returns an open_memstream FILE positioned at the start (the
+ * buffer is freed when the stream is closed), or NULL with errno set
+ * when the domain file cannot be read. */
+FILE *__pwconf_passwd_fopen(void)
+{
+	struct pwdb db = { NULL, 0 };
+	struct pwentry *entries = NULL;
+	struct recidx *idx = NULL;
+	FILE *f = NULL;
+	char *buf = NULL;
+	size_t len = 0;
+	FILE *in;
+	char *text = NULL;
+	long n;
+	int nrec = 0, i;
+
+	in = fopen(PWCONF_PASSWD_PATH, "rbe");
+	if(!in) {
+		return NULL;	/* errno from fopen (ENOENT etc.) */
+	}
+	if(fseek(in, 0, SEEK_END) || (n = ftell(in)) < 0 ||
+	   (unsigned long)n > PWCONF_MAX_FILE) {
+		errno = EFBIG;
+		goto out;
+	}
+	rewind(in);
+	text = malloc((size_t)n + 1);
+	if(!text) {
+		errno = ENOMEM;
+		goto out;
+	}
+	if(fread(text, 1, (size_t)n, in) != (size_t)n) {
+		errno = EIO;
+		goto out;
+	}
+	text[n] = '\0';
+	if(pwconf_parse(text, (size_t)n, &entries) ||
+	   pwdb_build(&db, entries, "user")) {
+		errno = EIO;
+		goto out;
+	}
+	nrec = db.nrecs;
+	idx = calloc(nrec ? (size_t)nrec : 1, sizeof(*idx));
+	if(!idx) {
+		errno = ENOMEM;
+		goto out;
+	}
+	for(i = 0; i < nrec; i++) {
+		struct pwrec *r;
+		int k;
+
+		for(k = 0, r = db.recs; k < i; k++) {
+			r = r->next;
+		}
+		idx[i].rec = r;
+		pwconf_raw_int(pwrec_field(r, "uid"), &idx[i].key);
+	}
+	qsort(idx, (size_t)nrec, sizeof(*idx), recidx_cmp);
+
+	f = open_memstream(&buf, &len);
+	if(!f) {
+		errno = ENOMEM;
+		goto out;
+	}
+	for(i = 0; i < nrec; i++) {
+		struct pwrec *r = idx[i].rec;
+		char *passwd, *gecos, *dir, *shell;
+		unsigned uid, gid;
+
+		passwd = pwconf_unquote(pwrec_field(r, "password") ?
+					pwrec_field(r, "password") : "");
+		gecos = pwconf_unquote(pwrec_field(r, "gecos") ?
+				       pwrec_field(r, "gecos") : "");
+		dir = pwconf_unquote(pwrec_field(r, "home") ?
+				     pwrec_field(r, "home") : "");
+		shell = pwconf_unquote(pwrec_field(r, "shell") ?
+				       pwrec_field(r, "shell") : "");
+		if(!passwd || !gecos || !dir || !shell) {
+			free(passwd);
+			free(gecos);
+			free(dir);
+			free(shell);
+			errno = ENOMEM;
+			fclose(f);
+			f = NULL;
+			goto out;
+		}
+		pwconf_raw_int(pwrec_field(r, "uid"), &uid);
+		pwconf_raw_int(pwrec_field(r, "gid"), &gid);
+		fprintf(f, "%s:%s:%u:%u:%s:%s:%s\n",
+			r->name, passwd, uid, gid, gecos, dir, shell);
+		free(passwd);
+		free(gecos);
+		free(dir);
+		free(shell);
+	}
+	/* open_memstream streams are write-only in musl: copy the rendered
+	 * text into a self-contained fmemopen stream (buffer embedded in the
+	 * FILE allocation, freed at fclose) so the line parsers can read it
+	 * back without leaking the buffer. */
+	if(fflush(f) || ferror(f)) {
+		fclose(f);
+		f = NULL;
+		errno = EIO;
+		goto out;
+	}
+	{
+		FILE *rf = fmemopen(NULL, len, "w+");
+
+		if(!rf) {
+			errno = ENOMEM;
+			fclose(f);
+			f = NULL;
+			goto out;
+		}
+		if(fwrite(buf, 1, len, rf) != len ||
+		   fflush(rf) || ferror(rf)) {
+			fclose(rf);
+			fclose(f);
+			f = NULL;
+			errno = EIO;
+			goto out;
+		}
+		rewind(rf);
+		fclose(f);	/* frees the memstream buffer */
+		f = rf;
+	}
+out:
+	free(text);
+	pwconf_entries_free(entries);
+	pwdb_free(&db);
+	free(idx);
+	if(in) {
+		fclose(in);
+	}
+	return f;
+}
+
+/* Render the group domain. All records of the `group` container, sorted
+ * by gid. Same FILE contract as __pwconf_passwd_fopen. */
+FILE *__pwconf_group_fopen(void)
+{
+	struct pwdb db = { NULL, 0 };
+	struct pwentry *entries = NULL;
+	struct recidx *idx = NULL;
+	FILE *f = NULL;
+	char *buf = NULL;
+	size_t len = 0;
+	FILE *in;
+	char *text = NULL;
+	long n;
+	int nrec = 0, i;
+
+	in = fopen(PWCONF_GROUP_PATH, "rbe");
+	if(!in) {
+		return NULL;	/* errno from fopen (ENOENT etc.) */
+	}
+	if(fseek(in, 0, SEEK_END) || (n = ftell(in)) < 0 ||
+	   (unsigned long)n > PWCONF_MAX_FILE) {
+		errno = EFBIG;
+		goto out;
+	}
+	rewind(in);
+	text = malloc((size_t)n + 1);
+	if(!text) {
+		errno = ENOMEM;
+		goto out;
+	}
+	if(fread(text, 1, (size_t)n, in) != (size_t)n) {
+		errno = EIO;
+		goto out;
+	}
+	text[n] = '\0';
+	if(pwconf_parse(text, (size_t)n, &entries) ||
+	   pwdb_build(&db, entries, "group")) {
+		errno = EIO;
+		goto out;
+	}
+	nrec = db.nrecs;
+	idx = calloc(nrec ? (size_t)nrec : 1, sizeof(*idx));
+	if(!idx) {
+		errno = ENOMEM;
+		goto out;
+	}
+	for(i = 0; i < nrec; i++) {
+		struct pwrec *r;
+		int k;
+
+		for(k = 0, r = db.recs; k < i; k++) {
+			r = r->next;
+		}
+		idx[i].rec = r;
+		pwconf_raw_int(pwrec_field(r, "gid"), &idx[i].key);
+	}
+	qsort(idx, (size_t)nrec, sizeof(*idx), recidx_cmp);
+
+	f = open_memstream(&buf, &len);
+	if(!f) {
+		errno = ENOMEM;
+		goto out;
+	}
+	for(i = 0; i < nrec; i++) {
+		struct pwrec *r = idx[i].rec;
+		char **members = NULL;
+		int nm, j;
+		unsigned gid;
+
+		nm = pwconf_members(pwrec_field(r, "members"), &members);
+		if(nm < 0) {
+			errno = ENOMEM;
+			fclose(f);
+			f = NULL;
+			goto out;
+		}
+		pwconf_raw_int(pwrec_field(r, "gid"), &gid);
+		fprintf(f, "%s::%u:", r->name, gid);
+		for(j = 0; j < nm; j++) {
+			fprintf(f, "%s%s", j ? "," : "", members[j]);
+			free(members[j]);
+		}
+		free(members);
+		fprintf(f, "\n");
+	}
+	/* open_memstream streams are write-only in musl: copy the rendered
+	 * text into a self-contained fmemopen stream (buffer embedded in the
+	 * FILE allocation, freed at fclose) so the line parsers can read it
+	 * back without leaking the buffer. */
+	if(fflush(f) || ferror(f)) {
+		fclose(f);
+		f = NULL;
+		errno = EIO;
+		goto out;
+	}
+	{
+		FILE *rf = fmemopen(NULL, len, "w+");
+
+		if(!rf) {
+			errno = ENOMEM;
+			fclose(f);
+			f = NULL;
+			goto out;
+		}
+		if(fwrite(buf, 1, len, rf) != len ||
+		   fflush(rf) || ferror(rf)) {
+			fclose(rf);
+			fclose(f);
+			f = NULL;
+			errno = EIO;
+			goto out;
+		}
+		rewind(rf);
+		fclose(f);	/* frees the memstream buffer */
+		f = rf;
+	}
+out:
+	free(text);
+	pwconf_entries_free(entries);
+	pwdb_free(&db);
+	free(idx);
+	if(in) {
+		fclose(in);
+	}
+	return f;
+}
diff --git a/src/passwd/pwconf.h b/src/passwd/pwconf.h
new file mode 100644
index 00000000..a1cbcfbf
--- /dev/null
+++ b/src/passwd/pwconf.h
@@ -0,0 +1,21 @@
+/* pwconf.h — libc-internal .conf-domain reader for the FNX identity
+ * records (docs/system-config-files-plan.md M3).
+ *
+ * getpwnam/getpwuid and getgrnam/getgrgid consume the record domains
+ * in /System/Configuration (system.passwd.conf /
+ * system.group.conf) instead of legacy colon files. Each record
+ * is rendered as a classic "name:passwd:uid:gid:..." line over a
+ * self-contained fmemopen stream, so the existing musl line parsers
+ * (__getpwent_a / __getgrent_a) work unchanged. Rendering sorts
+ * records by uid (passwd) / gid (group).
+ */
+
+#ifndef PWCONF_H
+#define PWCONF_H
+
+#include <stdio.h>
+
+hidden FILE *__pwconf_passwd_fopen(void);
+hidden FILE *__pwconf_group_fopen(void);
+
+#endif
