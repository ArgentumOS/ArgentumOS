+/* pwconf.h — libc-internal .conf-domain reader for the FNX identity
+ * records (docs/system-config-files-plan.md M3).
+ *
+ * getpwnam/getpwuid and getgrnam/getgrgid consume the record domains
+ * in /System/Configuration (system.config.passwd.conf /
+ * system.config.group.conf) instead of legacy colon files. Each record
+ * is rendered as a classic "name:passwd:uid:gid:..." line over a
+ * self-contained fmemopen stream, so the existing musl line parsers
+ * (__getpwent_a / __getgrent_a) work unchanged. Rendering sorts
+ * records by uid (passwd) / gid (group).
+ */
+
+#ifndef PWCONF_H
+#define PWCONF_H
+
+#include <stdio.h>
+
+hidden FILE *__pwconf_passwd_fopen(void);
+hidden FILE *__pwconf_group_fopen(void);
+
+#endif
