prefix=/home/kyle/Development/Fiwix/.build/x11-prefix
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Xfont2
Description: X font Library version 2
Version: 2.0.7
Requires: xproto fontsproto
Requires.private: fontenc  zlib
Cflags: -I${includedir}
Libs: -L${libdir} -lXfont2
Libs.private:  -lm
