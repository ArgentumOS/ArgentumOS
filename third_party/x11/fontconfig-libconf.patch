diff --git a/third_party/x11/fontconfig/src/fclibconf.c b/third_party/x11/fontconfig/src/fclibconf.c
new file mode 100644
index 0000000..9324aed
--- /dev/null
+++ b/third_party/x11/fontconfig/src/fclibconf.c
@@ -0,0 +1,152 @@
+/*
+ * fontconfig/src/fclibconf.c
+ *
+ * FNX: fontconfig configuration from the libconfig domain
+ * (docs/design/fontconfig-config-plan.md). The default-config load path
+ * reads /System/Configuration/system.fonts.conf (scope CONFIG_SCOPE_SYSTEM,
+ * domain "system.fonts") with the FNX libconfig C API and drives the same
+ * internal builders fcxml.c uses, so the public FcConfig readers behave as
+ * before.
+ *
+ * M0 scope (fontconfig-config-plan §5): dirs / cachedir / rescan and the
+ * selectfont accept/reject globs. The full match/test/edit rule DSL is M1.
+ *
+ * Permission is hereby granted to use this file under the same terms as
+ * the fontconfig license (MIT-style, see the COPYING file).
+ */
+
+#include "fcint.h"
+#include <libconfig.h>
+
+#include <string.h>
+
+#define FC_DOMAIN	"system.fonts"
+
+/* Reads one flat dotted key from the domain (scope system). Returns:
+ *   1  found and copied into *out (caller frees)
+ *   0  absent (NOT_FOUND / TYPE on an absent key)
+ *  -1  hard error (PARSE / IO / other): the domain exists but is broken
+ */
+static int
+FcLibconfGetString (const char *key, FcChar8 **out)
+{
+    const char *v = NULL;
+    config_err_t e = config_get_string (FC_DOMAIN, key, &v);
+
+    if (e == CONFIG_OK && v)
+    {
+	*out = (FcChar8 *) FcStrdup ((const FcChar8 *) v);
+	return *out != NULL ? 1 : -1;
+    }
+    if (e == CONFIG_ERR_NOT_FOUND || e == CONFIG_ERR_TYPE)
+	return 0;	/* absent key */
+    return -1;		/* domain present but unreadable */
+}
+
+/* dirs = /a, /b   (comma list of absolute FSH paths) */
+static FcBool
+FcLibconfLoadDirs (FcConfig *config)
+{
+    config_value_t *items;
+    size_t n, i;
+    config_err_t e;
+
+    e = config_get_array (FC_DOMAIN, "dirs", &items, &n);
+    if (e == CONFIG_ERR_NOT_FOUND || e == CONFIG_ERR_TYPE)
+	return FcTrue;	/* no dirs key: leave FcConfigCreate's empty set */
+    if (e != CONFIG_OK)
+	return FcFalse;
+    if (!FcConfigResetFontDirs (config))
+	return FcFalse;
+    for (i = 0; i < n; i++)
+    {
+	if (items[i].type != CONFIG_TYPE_STRING || !items[i].v.string)
+	    return FcFalse;
+	if (!FcConfigAddFontDir (config,
+				 (const FcChar8 *) items[i].v.string,
+				 NULL, NULL))
+	    return FcFalse;
+    }
+    return FcTrue;
+}
+
+static FcBool
+FcLibconfLoadCachedir (FcConfig *config)
+{
+    FcChar8 *d = NULL;
+    int r = FcLibconfGetString ("cachedir", &d);
+
+    if (r <= 0)
+	return r == 0;	/* absent: fcinit supplies the default cachedir;
+			 * broken domain: hard error */
+    if (!FcConfigAddCacheDir (config, (const FcChar8 *) d))
+    {
+	FcStrFree (d);
+	return FcFalse;
+    }
+    FcStrFree (d);
+    return FcTrue;
+}
+
+static FcBool
+FcLibconfLoadRescan (FcConfig *config)
+{
+    int64_t v;
+    config_err_t e = config_get_int (FC_DOMAIN, "rescan", &v);
+
+    if (e != CONFIG_OK)
+	return FcTrue;	/* absent: default 30 already set */
+    return FcConfigSetRescanInterval (config, (int) v);
+}
+
+/* accept = [ "/glob", ... ]  /  reject = [ ... ] */
+static FcBool
+FcLibconfLoadGlobs (FcConfig *config, FcBool accept)
+{
+    config_value_t *items;
+    size_t n, i;
+    config_err_t e;
+
+    e = config_get_array (FC_DOMAIN, accept ? "accept" : "reject",
+			  &items, &n);
+    if (e == CONFIG_ERR_NOT_FOUND || e == CONFIG_ERR_TYPE)
+	return FcTrue;
+    if (e != CONFIG_OK)
+	return FcFalse;
+    for (i = 0; i < n; i++)
+    {
+	if (items[i].type != CONFIG_TYPE_STRING || !items[i].v.string)
+	    return FcFalse;
+	if (!FcConfigGlobAdd (config,
+			      (const FcChar8 *) items[i].v.string, accept))
+	    return FcFalse;
+    }
+    return FcTrue;
+}
+
+/* Populate `config` from the system.fonts domain. M0: dirs, cachedir,
+ * rescan, accept/reject globs. Returns FcFalse on a hard error (domain
+ * unreadable with a parse error, or a value of the wrong shape). */
+FcBool
+FcConfigLoadDomain (FcConfig *config)
+{
+    if (!config)
+	return FcFalse;
+
+    /* config_get_* resolves through the same scope machinery every FNX
+     * config reader uses (system -> user -> shared; this domain ships in
+     * the system scope). A missing domain is NOT an error here: fcinit's
+     * fallback supplies default dirs + cachedir, mirroring how the stock
+     * built-in XML behaves when fonts.conf is absent. */
+    if (!FcLibconfLoadDirs (config))
+	return FcFalse;
+    if (!FcLibconfLoadCachedir (config))
+	return FcFalse;
+    if (!FcLibconfLoadRescan (config))
+	return FcFalse;
+    if (!FcLibconfLoadGlobs (config, FcTrue))
+	return FcFalse;
+    if (!FcLibconfLoadGlobs (config, FcFalse))
+	return FcFalse;
+    return FcTrue;
+}
