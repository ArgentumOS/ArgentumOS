/*
 * EmitsCore.ag — the statement and expression core, as emitted.
 *
 * Copyright © 2026 Kyle J. Cardoza. MIT licence (see docs/LICENSE).
 *
 * One of the golden specimens: `sterlingc.sh --golden` emits this file and diffs
 * the result against EmitsCore.h / EmitsCore.m beside it. It exists because §2's
 * specimen exercises none of this — it has no local, no assignment, no message
 * send and no operator — so before this file the emitter could have lost any of
 * them and every other leg would still have been green.
 *
 * It is a program that has to COMPILE as well as match, because a golden diff
 * only proves the text is what we expected, not that what we expected was C.
 * `sterlingc-compile.sh` feeds the emitted `.m` to clang too, and two facts came
 * out of making it compile:
 *
 *   - `self` in a CLASS method is the class object, so a property read or write
 *     there is not the instance's. The body with members in it is an instance
 *     method; `announce` is the class method.
 *   - a property read is written `self.count`. A bare `count` is a local, and
 *     there is none.
 *
 * The parameters are single-named on purpose: `method report(name: String)`
 * writes one name for both the call label and the body's local. The two-name
 * form (`report(with name: String)`) is exactly where §2 and §5 disagree about
 * the first selector piece, and a golden that baked in one side of an unresolved
 * disagreement would assert the wrong thing confidently.
 */
class EmitsCore: Object {
    property count: Int32

    readonly property limit: Int32 {
        return 3;
    }

    method locals(scale: Int32) -> Void {
        let base: Int32 = 2;
        var total: Int32 = 0;
        let half: Float32 = 0.5;
        let ratio: Float64 = 0.25;
        let name: String = "core";
        /*
         * §7.19's omitted type, over LITERALS only: `let doubled = base * 2`
         * would need the type of an expression, which is inference, and the
         * emitter refuses that rather than guessing (see tests/refuse/).
         */
        let inferredInt = 3;
        let inferredFloat = 0.25;
        let inferredBool = true;
        let inferredString = "text";
        let doubled: Int32 = base * 2;
        let grouped: Int32 = (base + 2) * 3;
        let subtracted: Int32 = 10 - (2 - 1);
        let negated: Int32 = -(base + 2);
        let decided: Bool = base > 1 && scale != 0;

        total = doubled + grouped;
        total = total + subtracted;
        total = total + negated;
        total = total + inferredInt;
        self.count = total;
        self.count = self.count + inferredInt;

        if decided {
            self.count = 1;
        } else if total == 4 {
            self.count = 0;
        } else {
            self.count = 4;
        }

        while self.count < 10 {
            self.count = self.count + 1;
        }

        self.reset();
        self.report(name: name, total: total);
        self.scale(half: half, ratio: ratio, flag: inferredBool, text: inferredString);
    }

    class method announce(flag: Bool) -> Void {
        callSomeFunc(flag);
    }

    method reset() -> Void {
    }

    method report(name: String, total: Int32) -> Void {
    }

    method scale(half: Float32, ratio: Float64, flag: Bool, text: String) -> Void {
    }
}
