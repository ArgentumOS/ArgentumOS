/*
 * EmitsSurface.ag — the class surface: protocols, a conformance list, and the
 * property attributes.
 *
 * Copyright © 2026 Kyle J. Cardoza. MIT licence (see docs/LICENSE).
 *
 * The third golden specimen. It covers what the first two cannot: a protocol
 * with required and optional members, a protocol that inherits, a class that
 * conforms, and the ownership attribute of §7.52 — written (`copy`, `weak`) and
 * inferred (`strong` for a class type, `assign` for a scalar).
 *
 * Two ORDERING facts are deliberately tested here by writing the source the
 * wrong way round:
 *
 *   - the class conforming to `Printable` appears BEFORE `Printable` is
 *     declared, and
 *   - `Printable` inherits `Drawable` before `Drawable` is declared.
 *
 * Neither may matter: §7.45 makes a protocol name a type, and §5's forward
 * declaration rule covers it, so the emitter writes `@protocol Name;` lines and
 * the source order stops being load-bearing. A golden written in dependency
 * order would never have shown that.
 *
 * The class implements BOTH required members, including the one it inherits
 * through `Printable`, because §7.48's check requires it — a class missing one
 * is a compile-time error and this file would not parse.
 */
class EmitsSurface: Object, Printable {
    property title: String
    copy property label: String
    weak property owner: Object
    readonly property weight: Int32 {
        return 2;
    }

    method describe(name: String) -> String {
        self.title = name;
        self.label = name;
        self.owner = nil;
        return self.title;
    }

    method print() -> Void {
        return;
    }

    method draw() -> Void {
        return;
    }

    /*
     * §4's `T?` on a class type — `_Nullable` after the pointer, which the
     * header's `assume_nonnull begin` region is why it has to be written at all.
     * It covers the three positions a nullable type can appear in: a parameter,
     * a return, and a local (whose `const` follows the qualifier).
     *
     * And §7.42: `print()` here names one of THIS class's methods, so it emits
     * `[self print]` — the other half of the rule is a C function, which
     * EmitsCore's `callSomeFunc` is.
     */
    method nullable(name: String?) -> String? {
        /* `saved`, not `copy`: §5's attribute list makes `copy` reserved. */
        let saved: String? = name;
        print();
        return saved;
    }

    /*
     * §4's `Self` is `instancetype` — the return type that says "whatever class
     * this was sent to", which is what makes an inherited method's return type
     * follow the subclass.
     */
    method shared() -> Self {
        return self;
    }
}

/*
 * And §3's `super`: a receiver like `self`, emitted as it is written. It is a
 * KEYWORD rather than an identifier, which is why it needed a node of its own —
 * before this it was not merely unemitted but unspellable, a parse error.
 *
 * The subclass also holds EmitsSurface's `super.` calls to a method the
 * superclass DECLARES (`print`), so the emitted `[super print]` is checkable by
 * clang rather than being an unknown selector.
 */
class EmitsSurfaceChild: EmitsSurface {
    method preview() -> Void {
        super.print();
        return;
    }
}

protocol Printable: Drawable {
    method print() -> Void
    optional method preview() -> Void
    optional property tag: String
}

protocol Drawable {
    method draw() -> Void
}
