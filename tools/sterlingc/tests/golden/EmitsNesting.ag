/*
 * EmitsNesting.ag — nesting, the `if` chains, and an empty `else`.
 *
 * Copyright © 2026 Kyle J. Cardoza. MIT licence (see docs/LICENSE).
 *
 * The second golden specimen, and it covers a different axis from EmitsCore:
 * indentation depth, an `if` with no `else`, a chain of three, and an `else { }`
 * that is written but empty.
 *
 * It is not decoration. The emitter's first cut printed `} else \tif (…)` — the
 * nested `if` wrote its own indent onto a line that was already positioned. That
 * is valid C, so the compile leg passes it; only a diff against a reviewed file
 * sees it, which is the argument for having a file like this at all.
 */
class EmitsNesting: Object {
    property count: Int32

    method classify(scale: Int32) -> Void {
        var total: Int32 = scale;

        if total > 0 {
            total = total - 1;
            while total > 0 {
                if total == 1 {
                    self.count = 1;
                } else {
                    self.count = 2;
                }
                total = total - 1;
            }
        }

        if total == 0 {
            self.count = 0;
        } else if total < 0 {
            self.count = -1;
        } else if total == 1 {
            self.count = 3;
        } else {
        }
    }
}
