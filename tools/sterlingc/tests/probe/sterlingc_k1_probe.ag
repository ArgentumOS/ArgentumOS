 *
 * K1's guest half is now a hand-written ObjC driver, `userland/tests/sterlingc_k1.m`,
 * which links against the compiler's own emitted class and runs on a guest boot
 * (`tests/cases/sterlingc_k1.py`). It is ObjC rather than this file because
 * §1's specimen is a class with no top-level statements, so something has to
 * call it and the emitter cannot emit calls yet.
 *
 * So THIS file is the K2 target: the same chain, but written in Sterling, once
 * the emitter can produce message sends and statement bodies. It is kept so the
 * guest gate has its Sterling instrument the moment that lands — the shape and
 * the `STERLING <name> ok|FAIL` line protocol are already fixed here.
 */
import Foundation

func check(name: String, condition: Bool) -> Void { }

class Probe: Object {
    property myValue: Int64 = 0
    readonly property dynamicValue: Float32 { return 0.1 }

    class method baz(arg1: Bool, arg2: String) -> Void { }

    method foobar(argname: Int32, arg2: Bool) -> Bool { return false }
}
