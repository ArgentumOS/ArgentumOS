#!/System/Tools/sh
# Interactive Xfb desktop session (make run-xfb):
#   - Xfb :0 on the real framebuffer (/dev/fb0 = the QEMU window)
#   - demo windows: xdraw (red 400x300 at 100,100), xkey (input echo)
#   - console shell on the serial terminal for launching more clients
# Input: the QEMU window's PS/2 keyboard + USB mouse reach the guest via
# /dev/kbd + /dev/psaux (Xfb's defaults); nothing is exported here.
mount -t proc proc /proc 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
mkdir -p /System/Variable Data/log

# the BFS journal replays the previous run's writes at mount, so a
# killed session's /tmp/.X0-lock + /tmp/.X11-unix can come back with a
# now-reused PID - Xfb would refuse to start ("Server is already active
# for display 0"). Clear them before starting.
rm -rf /tmp/.X0-lock /tmp/.tX0-lock /tmp/.X11-unix

echo "XDESK: starting Xfb :0 on the framebuffer"
/bin/Xfb :0 -ac > /System/Variable Data/log/Xfb.log 2>&1 &

# wait for the server's unix listener before launching clients: under TCG
# the bind can lag, and XOpenDisplay "Connection refused" would kill the
# demo clients for good
n=0
while [ $n -lt 15 ]; do
	if [ -S /tmp/.X11-unix/X0 ]; then
		break
	fi
	sleep 1
	n=$((n + 1))
done
sleep 1

DISPLAY=:0 /bin/xdraw 100 100 400 300 &
echo "XDESK: xdraw window up (red 400x300 at 100,100), pid $!"

DISPLAY=:0 /bin/xkey &
echo "XDESK: xkey echo window up, pid $!"

echo "XDESK: ready."
echo "  * click the QEMU window and type  -> xkey echoes keysyms on this console"
echo "  * move/click in the window        -> cursor + xkey button/enter lines"
echo "  * try from here: DISPLAY=:0 /bin/xdraw 600 200 500 400"
/bin/sh
