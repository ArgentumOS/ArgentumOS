+/* FNX LOCAL MODIFICATION 5 (Apache-2.0 §4(b)): THE BRIDGE. Upstream's `#else` branch replaces the whole
+ * Objective-C dispatch vocabulary with stubs, and says why in ForFoundationOnly.h: "there's no Swift or ObjC
+ * runtime to interoperate with". This tree HAS one - libobjc2 - and plan §6 lists what the Apache port
+ * dropped as the work of the bridge. These four definitions are that work, and NONE OF THEM IS A GUESS:
+ *
+ * CF_IS_OBJC IS AN ISA COMPARISON, AND UPSTREAM'S OWN COMMENT SAYS SO (see __CFISAForTypeID above: "if you
+ * call CF_IS_OBJC on an objc object ... we will fail the isa comparison in CF_IS_OBJC"). An object is an
+ * Objective-C object when its first word is NOT the CF runtime class registered for the type it claims.
+ * The comparison is written out rather than routed through _CFTypeGetClass, which is defined FURTHER DOWN
+ * this header and so is not yet available here.
+ *
+ * THE DISPATCH MACROS FOLLOW CF_SWIFT_FUNCDISPATCHV_CHECK'S SHAPE, which is in this same file and is the
+ * sibling upstream does ship: `do { if (check(type, obj)) return (ret)...; } while (0)`. The second
+ * parameter is the RETURN TYPE - that is what the call sites show, e.g. CFString.c's
+ * `CF_OBJC_FUNCDISPATCHV(_kCFRuntimeIDCFString, CFIndex, (NSString *)str, length)`. RETAINED differs by
+ * ownership only: the CF function's contract is +1 while a Cocoa getter returns +0, which is what the
+ * macro's own name says.
+ *
+ * WITH THE CLASS TABLE EMPTY THIS CHANGES NOTHING ABOUT CF'S OWN OBJECTS, and that is deliberate for the
+ * first step: a CF-native object has _cfisa == __CFISAForTypeID(typeID) == 0 (INIT_CFRUNTIME_BASE sets 0),
+ * so CF_IS_OBJC is FALSE for it and CF keeps its own C path exactly as verified in M1. It is TRUE for a
+ * genuine NSString, whose isa is a real class pointer - which is the whole point. */
+/* A SMALL (TAGGED) OBJECT IS AN OBJECT AND MUST NOT BE DEREFERENCED - see FNX_CF_IS_SMALL_OBJECT in
+ * fnx-cf-bridge.h for the encoding, the runtime's rule, and the measurement that made this the fix: the
+ * isa read below faulted on a packed `@"..."` literal before any message was sent. THE ORDER IS LOAD-
+ * BEARING: `||` short-circuits, so a small object never reaches the dereference. */
+#define CF_IS_OBJC(typeID, obj) (FNX_CF_IS_SMALL_OBJECT(obj) || (((uintptr_t)((CFRuntimeBase *)(obj))->_cfisa) != __CFISAForTypeID(typeID)))
+
+#define CF_OBJC_FUNCDISPATCHV(typeID, rettype, obj, ...) do { \
+    if (CF_IS_OBJC(typeID, obj)) { \
+        return (rettype)[(id)(obj) __VA_ARGS__]; \
+    } \
+} while (0)
+
+#define CF_OBJC_RETAINED_FUNCDISPATCHV(typeID, rettype, obj, ...) do { \
+    if (CF_IS_OBJC(typeID, obj)) { \
+        return (rettype)[[(id)(obj) __VA_ARGS__] retain]; \
+    } \
+} while (0)
+
